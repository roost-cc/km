# Integration-test settings for a live Infisical instance.
#
# Copy this file to `test/.env` and fill in the three values below from
# your Infisical instance and its throwaway test project. `test/.env` is
# gitignored. Without INFISICAL_HOST the live-instance tests skip.
#
# See `docs/integration-tests.md` for a full setup walkthrough — how to
# create the test project, mint the machine-identity token, and pick a
# safe TTL.
#
# Existing exports in your shell (or CI secrets) win over this file:
# the loader uses `os.environ.setdefault`, so you can override one
# variable temporarily without editing the file.

# Base URL of the Infisical instance the tests talk to, e.g.
# http://localhost:8080/.
INFISICAL_HOST=

# Workspace id of a throwaway Infisical project the integration tests
# are allowed to write to and clean up. NEVER point this at a real
# project — `bootstrap_int_test.py` writes under `/s432-bootstrap/`
# and deletes everything it wrote on teardown.
INFISICAL_TEST_PROJECT_ID=

# Bearer token for a machine identity with read/write/delete on the
# project above. Issue a long-lived (TTL=0) identity token if you're
# willing to manage rotation manually; otherwise use a shorter TTL and
# refresh the file when it expires.
INFISICAL_TEST_TOKEN=
